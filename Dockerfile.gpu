# GPU version - PaddleX OCR with HPI (TensorRT/ONNX Runtime)
# For g4dn.xlarge (Tesla T4) on Amazon Linux.
# Requires: docker run --gpus all
#
# Based on PaddleX High Performance Inference:
# https://paddlepaddle.github.io/PaddleX/3.3/en/pipeline_deploy/high_performance_inference.html

FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app

# Python 3.10 + minimal deps (Ubuntu 22.04 default)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev python3-venv \
    libgomp1 libgl1 libglib2.0-0 curl \
    && rm -rf /var/lib/apt/lists/*

# PaddlePaddle GPU (CUDA 11.8, includes cuDNN - no separate install needed)
# Requires host GPU driver >= 450.80.02 (your 590.48 supports this)
RUN python3 -m pip install --no-cache-dir \
    -i https://www.paddlepaddle.org.cn/packages/stable/cu118/ paddlepaddle-gpu==3.2.2

# PaddleOCR + PaddleX serving
RUN python3 -m pip install --no-cache-dir \
    "paddleocr[all]>=3.0.0" \
    "paddlex[serving]>=3.2.0"

# HPI GPU plugin (TensorRT, ONNX Runtime backends for GPU)
RUN paddlex --install hpi-gpu

# Paddle2ONNX (recommended before HPI - enables model conversion for backends)
RUN paddlex --install paddle2onnx || true

# ocr_api proxy deps
RUN python3 -m pip install --no-cache-dir \
    fastapi>=0.100.0 uvicorn[standard]>=0.22.0 \
    python-multipart>=0.0.6 httpx>=0.24.0

COPY ocr_api.py .
COPY docker-entrypoint-gpu.sh /app/
RUN chmod +x /app/docker-entrypoint-gpu.sh

EXPOSE 8000

CMD ["/app/docker-entrypoint-gpu.sh"]
